{
  "name": "hotspotter",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "overrides": { "vite": "5.4.11" },
  "scripts": {
    "dev": "npm run dev -w @hotspotter/web",
    "e2e": "npm run e2e -w @hotspotter/web",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "9.1.0",
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
